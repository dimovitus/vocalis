{
  "name": "vocalis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --exclude 'src/**/*.integration.ts' --exclude 'src/**/*.e2e.tsx'",
    "test:integration": "vitest run --exclude 'src/**/*.test.ts' --exclude 'src/**/*.test.tsx'",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:rust && npm run test:python",
    "test:watch": "vitest",
    "dev:app": "bash scripts/dev.sh",
    "dev:app:wayland": "VOCALIS_USE_WAYLAND=1 bash scripts/dev.sh",
    "test:smoke": "bash scripts/smoke-test.sh",
    "setup:python": "bash scripts/setup-python.sh",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:python": "apps/ai-worker/.venv/bin/python -m pytest apps/ai-worker/tests -q || python3 -m pytest apps/ai-worker/tests -q"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.0.5"
  }
}
